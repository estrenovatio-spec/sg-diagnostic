# Database (локально можно указать один и тот же URL в обе переменные)
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5433/sg_diagnostic"
DIRECT_URL="postgresql://postgres:password@127.0.0.1:5433/sg_diagnostic"

# На Vercel после подключения Storage:
# DATABASE_URL  = POSTGRES_PRISMA_URL
# DIRECT_URL    = POSTGRES_URL_NON_POOLING

# AI — провайдер: openai | deepseek | qwen
AI_PROVIDER="openai"
AI_MODEL="gpt-4o-mini"
AI_TEMPERATURE="0.3"
# AI_BASE_URL=""  # опционально, свой endpoint

# Ключи (достаточно одного для выбранного провайдера):
OPENAI_API_KEY="sk-..."
# DEEPSEEK_API_KEY=""     # https://platform.deepseek.com
# DASHSCOPE_API_KEY=""    # Qwen: https://dashscope.aliyun.com (межд. — dashscope-intl)
# AI_API_KEY=""           # универсальный fallback

# Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
# Optional: numeric chat id for @username lookup fallback
ADMIN_DASHBOARD_URL="http://localhost:3000"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
NEXT_PUBLIC_PD_POLICY_URL="https://disk.yandex.com/i/g5N3DHyx1ROiGQ"
NEXT_PUBLIC_BOOKING_URL="https://calendly.com/"
CRON_SECRET="cron-secret-for-vercel"

# Google Sheets (опционально) — см. docs/GOOGLE-SHEETS.md
# GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/.../exec"

# Security
RATE_LIMIT_SECRET="change-me-in-production"
